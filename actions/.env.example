PORT=4000

# Hasura connection (from your nhost project)
HASURA_GRAPHQL_URL=https://<your-subdomain>.hasura.<your-region>.nhost.run/v1/graphql
HASURA_ADMIN_SECRET=<hasura-admin-secret>

# Shared secret Hasura must send on every Action/Event/Cron call
# (set the same value in hasura/metadata/actions.yaml env ACTION_SECRET)
ACTION_SECRET=<random-long-string>

# LLM provider for llm_call steps — leave unset to use the disclosed stub
GROQ_API_KEY=
